# Copia este archivo a .env.local y completa los valores.
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: todas son solo de servidor.

IMEICHECK_API_KEY=            # API key de imeicheck.com (NUNCA en el cliente)
IMEICHECK_BASE_URL=https://alpha.imeicheck.com/api/php-api
APP_PASSWORD=                 # contraseña de acceso a la página (usa una larga)
SESSION_SECRET=               # opcional: secreto para firmar la cookie (si falta, se usa APP_PASSWORD)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # solo servidor
